<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <application android:label="e-reading v0.1.0" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:usesCleartextTraffic="false">
        <activity android:name=".ReaderActivity" android:exported="true" android:launchMode="singleTop" android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter android:label="e-reading v0.1.0">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content"/>
                <data android:mimeType="text/plain"/>
                <data android:mimeType="application/pdf"/>
                <data android:mimeType="application/epub+zip"/>
                <data android:mimeType="application/x-mobipocket-ebook"/>
                <data android:mimeType="application/vnd.comicbook+zip"/>
                <data android:mimeType="application/x-cbz"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
